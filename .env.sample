# Keys in this file carry NO prefix. The same key set via the OS environment
# must be prefixed with APP_ (APP_DB_HOST), and the OS value wins — that is how
# docker-compose points the container at the `db` host while this file points at
# localhost for running the binary directly.
#
# Full reference: https://github.com/pskclub/mine-core/blob/master/v2/docs/env.md

ENV=dev
SERVICE=mine-core-template
HOST=0.0.0.0:3000

# api (default) | worker | all. No APP_ prefix in this file — that prefix is for
# OS environment variables, so `APP_ROLE=all` written here is ignored.
# ROLE=api

LOG_LEVEL=debug
LOG_SIMPLE=true

# One URI configures the driver, host and credentials; the discrete DB_* fields
# are ignored whenever it is set.
DB_CONNECTION_STRING=postgres://my_user:my_password@localhost:5432/my_database?sslmode=disable

# Prisma owns the schema (migrations + seed) and reads its own variable.
DATABASE_URL="postgresql://my_user:my_password@localhost:5432/my_database?schema=public"

CACHE_CONNECTION_STRING=redis://localhost:26379/0

# Optional — a connection is only opened when its config is present.
# MQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672/

# Set the DSN and errors, panics and job failures report themselves.
# SENTRY_DSN=
# SENTRY_RELEASE=mine-core-template@1.0.0

# Required: every token is signed with it, and the service refuses to start
# without one. Generate a real value per environment, e.g. `openssl rand -hex 32`.
# JWT_SECRET=dev-secret-change-me

# A key belonging to one module rather than to the framework: modules/exchange
# reads it with ctx.ENV().String("exchange_base_url"). Left unset on purpose —
# /exchange-rates then answers EXCHANGE_NOT_CONFIGURED instead of quietly
# calling a third party nobody chose. Point it at your provider to enable it.
#
# Frankfurter needs no key and speaks the shape this module expects:
# GET {base}/latest?base=THB&symbols=USD -> {"base":..,"date":..,"rates":{..}}.
# Note the /v1 — the path this module appends is /latest, not /v1/latest.
EXCHANGE_BASE_URL=https://api.frankfurter.dev/v1

# --- Self-inspection panels ---------------------------------------------------
# /_docs  the API reference — every endpoint, with a button that sends it
# /_dev   the inspector — capabilities, routes, config, jobs, modules, health
#
# On automatically when ENV=dev, and unprotected there (a laptop). Anywhere else
# they exist only if a password is set here, because /_docs is a map of the whole
# attack surface and /_dev prints the configuration keys.
#
# Set them in staging to have the panels behind a browser login; leave them unset
# in production and neither route exists at all. The password is what turns each
# panel on — the username defaults to the panel's own name.
# DEVTOOLS_USER=devtools
# DEVTOOLS_PASSWORD=
# APIDOCS_USER=apidocs
# APIDOCS_PASSWORD=
