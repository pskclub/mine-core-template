# Read instead of .env when APP_ENV=test. That switch comes from the OS
# environment only — `ENV=test` in a file cannot select the file being read.
#
#	APP_ENV=test go test ./...

ENV=test
SERVICE=mine-core-template-test
HOST=0.0.0.0:3000

LOG_LEVEL=debug
LOG_SIMPLE=true

DB_CONNECTION_STRING=postgres://my_user:my_password@localhost:5432/my_database_test?sslmode=disable

JWT_SECRET=test-secret

# No SENTRY_DSN on purpose: the tracker stays a no-op, so tests never call out.
