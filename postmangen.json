{
  "name": "mine-core template - Complete Collection (Generated)",
  "id": "mine-core-template-project-generated",
  "base_url": "http://localhost:3000",
  "output": "data/postman_collection.generated.json",
  "openapi_output": "apispec/openapi.generated.json",
  "layout": "grouped",

  "auth_middlewares": [
    "AuthRequire",
    "AuthRole"
  ],

  "token_captures": {
    "/auth/login": "authToken"
  },

  "skip_dirs": [".git", "node_modules", "vendor", "testdata", "prisma"]
}
